# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# GROQ_API_KEY: Fast LPU provider for instant fallback.
GROQ_API_KEY=
GROQ_API_KEY_1=

# OPENROUTER_API_KEY: Free and paid open weights router.
OPENROUTER_API_KEY=

# MISTRAL_API_KEY: Mistral AI API key.
MISTRAL_API_KEY=

# COHERE_API_KEY: Cohere Command API key.
COHERE_API_KEY=

# HF_API_KEY: Hugging Face User Access Token for serverless inference.
HF_API_KEY=

# CUSTOM_AI_ENDPOINT: Optional local or custom endpoint (e.g. http://localhost:11434/v1/chat/completions)
CUSTOM_AI_ENDPOINT=
CUSTOM_AI_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=
